generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ... existing generator and datasource ...

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // App specific
  ownedLeagues  League[]       @relation("LeagueOwner")
  memberships   LeagueMember[]
  bets          Bet[]
  notifications Notification[]
  propUpdates   PropUpdate[]
  comments      Comment[]
  activities    Activity[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model League {
  id                String       @id @default(cuid())
  name              String
  description       String?
  inviteCode        String       @unique @default(cuid())
  startingCredits   Int          @default(1000)
  status            LeagueStatus @default(ACTIVE)
  // [REMOVED] mode field - now always prediction market style
  allowPropCreation Boolean      @default(true)
  showActivityFeed  Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  ownerId String
  owner   User   @relation("LeagueOwner", fields: [ownerId], references: [id])

  members       LeagueMember[]
  props         Prop[]
  activities    Activity[]
  notifications Notification[]
}

model LeagueMember {
  id       String   @id @default(cuid())
  leagueId String
  userId   String
  credits  Int      @default(1000)
  joinedAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdProps  Prop[] @relation("PropCreator")
  targetedProps Prop[] @relation("PropTarget")

  @@unique([leagueId, userId])
}

// [MODIFIED] Prop model for Prediction Market
model Prop {
  id         String     @id @default(cuid())
  leagueId   String
  creatorId  String
  // [NEW] Market Type
  marketType MarketType @default(BINARY) // BINARY or MULTIPLE_CHOICE (future exp.)

  question String

  // [NEW] Liquidity / Volume tracking
  liquidity Float @default(0) // Total amount bet on this prop

  // [REMOVED] odds, wagerAmount (These are now dynamic or per-bet)
  // [REMOVED] type (PropType: HIT/LINE are legacy)

  targetPlayerId     String?
  bettingDeadline    DateTime? // [MODIFIED] Now optional for pure prediction markets
  resolutionDeadline DateTime?
  winningChoiceId    String? // [NEW] Links to Choice logic

  // [NEW] Filtering fields
  category String? // e.g. "Social", "Sports", "Future", etc.
  person   String? // Person tagged in this prop

  status    PropStatus @default(LIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  league       League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  creator      LeagueMember  @relation("PropCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  targetPlayer LeagueMember? @relation("PropTarget", fields: [targetPlayerId], references: [id])

  choices  Choice[]
  bets     Bet[]
  updates  PropUpdate[]
  comments Comment[]
}

// [NEW] Choice Model
model Choice {
  id     String @id @default(cuid())
  propId String
  text   String // e.g. "Yes", "No", "Trump", "Biden"

  // Dynamic Pricing State
  probability Float @default(0.5) // 0.0 to 1.0
  poolAmount  Float @default(0) // Total credits bet on this choice

  prop Prop  @relation(fields: [propId], references: [id], onDelete: Cascade)
  bets Bet[]
}

// [MODIFIED] Bet Model
model Bet {
  id     String @id @default(cuid())
  propId String
  userId String

  // [MODIFIED] Link to Choice instead of hardcoded strings
  choiceId String
  choice   Choice @relation(fields: [choiceId], references: [id])

  amount Int // Amount wagered (credits)
  shares Float @default(0) // [NEW] Number of shares bought (for parimutuel/market logic)
  purchasePrice Float @default(0) // Probability at time of purchase (for cash-out math)

  // Cash-out tracking
  soldAt    DateTime? // When position was cashed out (null = still active)
  soldPrice Float?    // Credits received on cash-out

  createdAt DateTime @default(now())

  prop Prop @relation(fields: [propId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  propId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  prop Prop @relation(fields: [propId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String       @id @default(cuid())
  leagueId  String
  userId    String
  type      ActivityType
  content   String
  createdAt DateTime     @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PropUpdate {
  id        String   @id @default(cuid())
  propId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  prop Prop @relation(fields: [propId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  leagueId  String?
  type      NotificationType @default(SYSTEM)
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League? @relation(fields: [leagueId], references: [id])
}

enum NotificationType {
  BET_WON
  BET_LOST
  PROP_ON_YOU
  SYSTEM
}

enum LeagueStatus {
  PRE_DRAFT
  ACTIVE
  COMPLETED
}

// [REMOVED] LeagueMode enum - now only prediction market style

// [NEW] Market Type
enum MarketType {
  BINARY // Two outcomes (Yes/No)
  MULTIPLE_CHOICE // >2 outcomes
}

enum PropStatus {
  LIVE
  LOCKED
  RESOLVED
  CANCELED
}

enum ActivityType {
  JOIN
  CREATE_PROP
  BET
  WIN
  COMMENT
  ADMIN
}
